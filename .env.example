# PostgreSQL 连接串（第 1 章启用；本地 docker compose 起库后填写）
DATABASE_URL=postgresql://waveflow:waveflow@localhost:5432/waveflow
# GitHub OAuth App 凭据（第 2 章启用；https://github.com/settings/developers 创建，回调路径 /auth/github/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# JWT 签名密钥（第 2 章启用；生成：openssl rand -hex 32）
JWT_SECRET=
# AES-256-GCM 主密钥，用于模型凭据加密（第 3 章启用；生成：openssl rand -hex 32）
MASTER_KEY=
# HTTP 服务端口（可选，默认 3077）
PORT=3077
